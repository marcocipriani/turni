    "test": "npm run test --workspace server && npm run test --workspace web",
    "migra": "tsx server/src/db/migra.ts",
    "seed": "tsx server/src/seed/run.ts",
    "avvio": "tsx server/src/avvio.ts",
    "importa": "tsx server/src/importa.ts",
    "verifica": "tsx server/src/verifica.ts",
    "carico": "tsx server/src/carico.ts"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.19.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "axe-core": "^4.13.0"
  },
