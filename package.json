  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web && wait",
    "build": "npm run build --workspace server && npm run build --workspace web",
