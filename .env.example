# Ambiente di sviluppo. Copiare in .env e riempire.
# Per la produzione il pacchetto di rilascio porta il proprio .env.esempio.

DATABASE_URL=mysql://turni:password@127.0.0.1:3306/turni
PORT=8787
NODE_ENV=development

# Nome del cookie di sessione: cambiarlo invalida tutte le sessioni aperte.
SESSION_COOKIE=turni_session

# Password unica dell'ambiente di prova, almeno otto caratteri.
# Il popolamento si rifiuta di girare senza, e con NODE_ENV=production.
SEED_PASSWORD=
SEED_EMAIL_DOMAIN=turni.test

# Archivio alternativo per il popolamento, se vuoi provare con nomi veri
# tenendoli fuori dal repository. Percorso relativo alla cartella da cui lanci.
# SEED_DATI=../private/dati-reali.json

# Notifiche push. Generare la coppia una volta sola:
#   npx web-push generate-vapid-keys
# Senza, l'applicazione funziona e il centro notifiche pure: resta spento
# solo l'avviso del browser.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tecnico@esempio.it
